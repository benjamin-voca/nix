      "metadata": {
        "name": "voltrum-motion",
        "labels": {
          "app.kubernetes.io/name": "voltrum-motion"
        }
      }
    },
    {
      "apiVersion": "v1",
      "kind": "ConfigMap",
      "metadata": {
        "name": "motion-site-c9ab4bdb8d56",
        "namespace": "voltrum-motion",
        "labels": {
          "app.kubernetes.io/name": "voltrum-motion"
        }
      },
      "immutable": true,
      "binaryData": {
        "site.tgz": ""
      },
      "data": {
        "nginx.conf": "pid /tmp/nginx.pid;\nevents { worker_connections 256; }\nhttp {\n  types { text/html html; text/css css; application/javascript js mjs; application/json json; image/svg+xml svg; image/png png; image/x-icon ico; text/plain txt; }\n  default_type application/octet-stream;\n  access_log /dev/stdout;\n  error_log /dev/stderr warn;\n  client_body_temp_path /tmp/client_body;\n  proxy_temp_path /tmp/proxy;\n  fastcgi_temp_path /tmp/fastcgi;\n  uwsgi_temp_path /tmp/uwsgi;\n  scgi_temp_path /tmp/scgi;\n  gzip on;\n  gzip_types application/json application/javascript text/css image/svg+xml;\n  server {\n    listen 8080;\n    server_name motion.voltrum.co;\n    root /site;\n    index index.html;\n    add_header Cache-Control no-cache always;\n    add_header X-Content-Type-Options nosniff always;\n    add_header Referrer-Policy strict-origin-when-cross-origin always;\n    add_header X-Frame-Options DENY always;\n    add_header Permissions-Policy 'camera=(), microphone=(), geolocation=()' always;\n    add_header Content-Security-Policy \"default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self'; media-src 'none'; connect-src 'self'; object-src 'none'; base-uri 'self'; frame-ancestors 'none'\" always;\n    location = /healthz { access_log off; return 200 'ok'; }\n    location ~ ^/(catalog|release)\\.json$ { expires -1; try_files $uri =404; }\n    location / { try_files $uri $uri/ =404; }\n  }\n}\n"
      }
    },
    {
      "apiVersion": "apps/v1",
      "kind": "Deployment",
      "metadata": {
        "name": "voltrum-motion",
        "namespace": "voltrum-motion",
        "labels": {
          "app.kubernetes.io/name": "voltrum-motion"
        }
      },
      "spec": {
        "replicas": 2,
        "revisionHistoryLimit": 3,
        "selector": {
          "matchLabels": {
            "app.kubernetes.io/name": "voltrum-motion"
          }
        },
        "template": {
          "metadata": {
            "labels": {
              "app.kubernetes.io/name": "voltrum-motion"
            },
            "annotations": {
              "voltrum.co/site-sha256": "c9ab4bdb8d569663e5428fd34c1abd4cf7c4989e3a1ef3022990f68fec48c45e"
            }
          },
          "spec": {
            "automountServiceAccountToken": false,
            "securityContext": {
              "runAsNonRoot": true,
              "runAsUser": 101,
              "runAsGroup": 101,
              "seccompProfile": {
                "type": "RuntimeDefault"
              },
              "fsGroup": 101
            },
            "tolerations": [
              {
                "key": "role",
                "operator": "Equal",
                "value": "backbone",
                "effect": "NoSchedule"
              },
              {
                "key": "infra",
                "operator": "Equal",
                "value": "true",
                "effect": "NoSchedule"
              }
            ],
            "initContainers": [
              {
                "name": "unpack",
                "image": "nginx:1.28.0-alpine@sha256:30f1c0d78e0ad60901648be663a710bdadf19e4c10ac6782c235200619158284",
                "command": [
                  "/bin/sh",
                  "-ec",
                  "tar -xzf /archive/site.tgz -C /site"
                ],
                "securityContext": {
                  "allowPrivilegeEscalation": false,
                  "readOnlyRootFilesystem": true,
                  "capabilities": {
                    "drop": [
                      "ALL"
                    ]
                  }
                },
                "resources": {
                  "requests": {
                    "cpu": "10m",
                    "memory": "16Mi"
                  },
                  "limits": {
                    "cpu": "100m",
                    "memory": "64Mi"
                  }
                },
                "volumeMounts": [
                  {
                    "name": "archive",
                    "mountPath": "/archive",
                    "readOnly": true
                  },
                  {
                    "name": "site",
                    "mountPath": "/site"
                  }
                ]
              }
            ],
            "containers": [
              {
                "name": "web",
                "image": "nginx:1.28.0-alpine@sha256:30f1c0d78e0ad60901648be663a710bdadf19e4c10ac6782c235200619158284",
                "command": [
                  "nginx",
                  "-c",
                  "/archive/nginx.conf",
                  "-g",
                  "daemon off;"
                ],
                "ports": [
                  {
                    "name": "http",
                    "containerPort": 8080
                  }
                ],
                "securityContext": {
                  "allowPrivilegeEscalation": false,
                  "readOnlyRootFilesystem": true,
                  "capabilities": {
                    "drop": [
                      "ALL"
                    ]
                  }
                },
                "resources": {
                  "requests": {
                    "cpu": "10m",
                    "memory": "24Mi"
                  },
                  "limits": {
                    "cpu": "200m",
                    "memory": "96Mi"
                  }
                },
                "readinessProbe": {
                  "httpGet": {
                    "path": "/healthz",
                    "port": "http"
                  },
                  "periodSeconds": 5
                },
                "livenessProbe": {
                  "httpGet": {
                    "path": "/healthz",
                    "port": "http"
                  },
                  "periodSeconds": 20
                },
                "volumeMounts": [
                  {
                    "name": "archive",
                    "mountPath": "/archive",
                    "readOnly": true
                  },
                  {
                    "name": "site",
                    "mountPath": "/site",
                    "readOnly": true
                  },
                  {
                    "name": "tmp",
                    "mountPath": "/tmp"
                  }
                ]
              }
            ],
            "volumes": [
              {
                "name": "archive",
                "configMap": {
                  "name": "motion-site-c9ab4bdb8d56"
                }
              },
              {
                "name": "site",
                "emptyDir": {}
              },
              {
                "name": "tmp",
                "emptyDir": {}
              }
            ]
          }
        }
      }
    },
