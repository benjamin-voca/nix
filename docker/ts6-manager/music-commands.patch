+  // ─── Repeat / Shuffle / Seek / Sleep / AutoDJ ─────────
+
+  private handleRepeat(bot: VoiceBot, userClid: number, args: string): void {
+    const MODES: Record<string, RepeatMode> = {
+      off: 'off', none: 'off', stop: 'off',
+      one: 'track', track: 'track', single: 'track',
+      all: 'queue', queue: 'queue',
+    };
+    const label = (m: RepeatMode) => (m === 'off' ? 'off' : m === 'queue' ? 'whole queue' : 'current track');
+    if (!args) {
+      const order: RepeatMode[] = ['off', 'queue', 'track'];
+      const next = order[(order.indexOf(bot.queue.repeat) + 1) % order.length];
+      bot.queue.setRepeat(next);
+      this.reply(bot, userClid, `Repeat: ${label(next)}`);
+      return;
+    }
+    const mode = MODES[args.toLowerCase()];
+    if (!mode) {
+      this.reply(bot, userClid, 'Usage: !repeat [off|one|all]');
+      return;
+    }
+    bot.queue.setRepeat(mode);
+    this.reply(bot, userClid, `Repeat: ${label(mode)}`);
+  }
+
+  private handleShuffle(bot: VoiceBot, userClid: number, args: string): void {
+    if (args === 'on' || args === 'off') {
+      bot.queue.setShuffle(args === 'on');
+    } else {
+      bot.queue.setShuffle(!bot.queue.shuffle);
+    }
+    this.reply(bot, userClid, `Shuffle: ${bot.queue.shuffle ? 'on' : 'off'}`);
+  }
+
+  private handleSearch(bot: VoiceBot, userClid: number, args: string): Promise<void> {
+    if (!args) {
+      this.reply(bot, userClid, 'Usage: !search <query> — then !pick <1-5>');
+      return Promise.resolve();
+    }
+    this.reply(bot, userClid, `Searching: ${args}...`);
+    return searchYouTube(args, 5).then((results) => {
+      if (!results || results.length === 0) {
+        this.reply(bot, userClid, `No results found for "${args}".`);
+        return;
+      }
+      this.pendingSearches.set(userClid, { results, expires: Date.now() + 3 * 60_000 });
+      const fmtDur = (d?: number) => (d ? ` [${Math.floor(d / 60)}:${String(Math.floor(d % 60)).padStart(2, '0')}]` : '');
+      const lines = results.map((r, i) => `[${i + 1}] ${r.title}${r.artist ? ` — ${r.artist}` : ''}${fmtDur(r.duration)}`);
+      this.reply(bot, userClid, `Results for "${args}":\n${lines.join('\n')}\n!pick <1-${results.length}> within 3 minutes.`);
+    }).catch((err: any) => {
+      this.reply(bot, userClid, `Search failed: ${err.message}`);
+    });
+  }
+
+  private async handlePick(bot: VoiceBot, userClid: number, args: string): Promise<void> {
+    const pending = this.pendingSearches.get(userClid);
+    if (!pending || pending.expires < Date.now()) {
+      this.pendingSearches.delete(userClid);
+      this.reply(bot, userClid, 'No active search. Use !search <query> first.');
+      return;
+    }
+    const n = parseInt(args);
+    if (isNaN(n) || n < 1 || n > pending.results.length) {
+      this.reply(bot, userClid, `Usage: !pick <1-${pending.results.length}>`);
+      return;
+    }
+    const r = pending.results[n - 1];
+    this.pendingSearches.delete(userClid);
+    this.reply(bot, userClid, `Picked [${n}]: ${r.title} — loading...`);
+    await this.downloadAndPlay(bot, userClid, `https://www.youtube.com/watch?v=${r.id}`);
+  }
+
+  private parseDurationSeconds(text: string): number | null {
+    const t = text.trim().toLowerCase();
+    if (/^\d+$/.test(t)) return parseInt(t);
+    const m = t.match(/^(\d+):([0-5]?\d)$/);
+    if (m) return parseInt(m[1]) * 60 + parseInt(m[2]);
+    return null;
+  }
+
+  private handleSeek(bot: VoiceBot, userClid: number, args: string): void {
+    const prog = bot.playbackProgress;
+    if (!prog) {
+      this.reply(bot, userClid, 'Nothing playing (live streams cannot seek).');
+      return;
+    }
+    const fmt = (s: number) => `${Math.floor(s / 60)}:${String(Math.floor(s % 60)).padStart(2, '0')}`;
+    if (!args) {
+      this.reply(bot, userClid, `Position: ${fmt(prog.position)} / ${fmt(prog.duration)}. Usage: !seek <sec|m:ss|+s|-s>`);
+      return;
+    }
+    let target: number | null = null;
+    if (/^\+\d+/.test(args)) {
+      const d = this.parseDurationSeconds(args.slice(1));
+      target = d === null ? null : prog.position + d;
+    } else if (/^-\d+/.test(args)) {
+      const d = this.parseDurationSeconds(args.slice(1));
+      target = d === null ? null : prog.position - d;
+    } else {
+      target = this.parseDurationSeconds(args);
+    }
+    if (target === null || isNaN(target)) {
+      this.reply(bot, userClid, 'Usage: !seek <sec|m:ss|+s|-s>');
+      return;
+    }
+    const max = prog.duration > 0 ? prog.duration - 1 : target;
+    const clamped = Math.max(0, Math.min(target, Math.max(0, max)));
+    bot.seek(clamped);
+    this.reply(bot, userClid, `Seeked to ${fmt(clamped)}.`);
+  }
+
+  private handleSleep(botId: number, bot: VoiceBot, userClid: number, args: string): void {
+    const existing = this.sleepTimers.get(botId);
+    if (!args) {
+      if (existing) {
+        const left = Math.max(0, Math.ceil((existing.endsAt - Date.now()) / 60000));
+        this.reply(bot, userClid, `Sleep timer: stopping in ${left} min.`);
+      } else {
+        this.reply(bot, userClid, 'Usage: !sleep <minutes> · !sleep off');
+      }
+      return;
+    }
+    if (args.toLowerCase() === 'off' || args === '0') {
+      if (existing) {
+        clearTimeout(existing.timer);
+        this.sleepTimers.delete(botId);
+      }
+      this.reply(bot, userClid, 'Sleep timer cancelled.');
+      return;
+    }
+    const mins = parseFloat(args);
+    if (isNaN(mins) || mins <= 0 || mins > 720) {
+      this.reply(bot, userClid, 'Usage: !sleep <1-720 minutes|off>');
+      return;
+    }
+    if (existing) clearTimeout(existing.timer);
+    const endsAt = Date.now() + mins * 60_000;
+    const timer = setTimeout(() => {
+      this.sleepTimers.delete(botId);
+      try {
+        bot.stopAudio();
+        bot.queue.clear();
+      } catch { }
+      this.reply(bot, userClid, 'Sleep timer finished — playback stopped.');
+    }, mins * 60_000);
+    this.sleepTimers.set(botId, { timer, endsAt, invokerClid: userClid });
+    this.reply(bot, userClid, `Sleep timer set: stopping in ${mins} min.`);
+  }
+
+  private handleAutoDj(botId: number, bot: VoiceBot, userClid: number, args: string): void {
+    if (!args || args === 'status') {
+      const on = this.autoDjEnabled.get(botId);
+      this.reply(bot, userClid, `AutoDJ: ${on ? 'on — plays random library tracks when the queue runs dry' : 'off'}. Usage: !autodj on|off`);
+      return;
+    }
+    if (args === 'on') {
+      this.autoDjEnabled.set(botId, true);
+      this.reply(bot, userClid, "AutoDJ on — I'll keep the music going from the library.");
+      this.maybeAutoDj(botId, bot).catch(() => { });
+      return;
+    }
+    if (args === 'off') {
+      this.autoDjEnabled.set(botId, false);
+      this.reply(bot, userClid, 'AutoDJ off.');
+      return;
+    }
+    this.reply(bot, userClid, 'Usage: !autodj [on|off]');
+  }
+
+  /** AutoDJ: queue empty + idle → play a weighted-random library track. */
+  private async maybeAutoDj(botId: number, bot: VoiceBot): Promise<void> {
+    if (!this.autoDjEnabled.get(botId)) return;
+    if (bot.queue.length > 0 || bot.nowPlaying || bot.status === 'stopped') return;
+    const dbBot = await this.prisma.musicBot.findUnique({ where: { id: botId }, select: { serverConfigId: true } });
+    if (!dbBot) return;
+    const songs = await this.prisma.song.findMany({ where: { serverConfigId: dbBot.serverConfigId } });
+    if (songs.length === 0) return;
+
+    // Weight by play history — favourites come up more often
+    const history = await this.prisma.musicRequest.findMany({
+      where: { serverConfigId: dbBot.serverConfigId },
+      select: { url: true },
+    });
+    const weights = new Map<string, number>();
+    for (const h of history) weights.set(h.url, (weights.get(h.url) ?? 0) + 1);
+
+    const recent = new Set(this.recentAutoDj.get(botId) ?? []);
+    const fresh = songs.filter((s) => !recent.has(s.sourceUrl ?? s.filePath));
+    const candidates = fresh.length > 0 ? fresh : songs;
+    const weightOf = (s: any) => 1 + (weights.get(s.sourceUrl ?? '') ?? 0);
+    const total = candidates.reduce((acc, s) => acc + weightOf(s), 0);
+    let roll = Math.random() * total;
+    let picked = candidates[candidates.length - 1];
+    for (const s of candidates) {
+      roll -= weightOf(s);
+      if (roll <= 0) { picked = s; break; }
+    }
+    this.recentAutoDj.set(botId, (this.recentAutoDj.get(botId) ?? []).concat(picked.sourceUrl ?? picked.filePath).slice(-5));
+
+    const item: QueueItem = {
+      id: `lib_${picked.id}_${Date.now()}`,
+      title: picked.title,
+      artist: picked.artist ?? undefined,
+      duration: picked.duration ?? undefined,
+      filePath: picked.filePath,
+      source: picked.source as any,
+      sourceUrl: picked.sourceUrl ?? undefined,
+    };
+    bot.queue.add(item);
+    const first = bot.queue.playAt(bot.queue.length - 1);
+    if (first) await bot.play(first);
+    console.log(`[MusicCmd] AutoDJ bot ${botId}: ${picked.title}`);
+  }
+
+  // ─── Playlist Commands ─────────────────────────────────
+
+  private async handlePlaylist(bot: VoiceBot, userClid: number, args: string): Promise<void> {
+    const playlists = await this.prisma.playlist.findMany({
+      include: { _count: { select: { songs: true } } },
+      orderBy: { id: 'asc' },
+    });
+
+    if (playlists.length === 0) {
+      this.reply(bot, userClid, 'No playlists. Create one in the web UI (Music Bots → Playlists).');
+      return;
+    }
+
+    const parts = args.trim().split(/\s+/);
+    const sub = (parts[0] || '').toLowerCase();
+    const target = parts.slice(1).join(' ').trim();
+
+    if (!sub || sub === 'list') {
+      const lines = playlists.map((p) => `[${p.id}] ${p.name} (${p._count.songs} tracks)`);
+      this.reply(bot, userClid, `Playlists:\n${lines.join('\n')}\n!playlist play <id|name> — replace queue & play\n!playlist queue <id|name> — append to queue\n!playlist add <id|name> — add current track`);
+      return;
+    }
+
+    if (sub !== 'play' && sub !== 'queue' && sub !== 'add') {
+      this.reply(bot, userClid, 'Usage: !playlist [list|play <id|name>|queue <id|name>|add <id|name>]');
+      return;
+    }
+
+    if (!target) {
+      this.reply(bot, userClid, `Usage: !playlist ${sub} <id|name>`);
+      return;
+    }
+
+    const asId = parseInt(target);
+    const summary = !isNaN(asId)
+      ? playlists.find((p) => p.id === asId)
+      : (playlists.find((p) => p.name.toLowerCase() === target.toLowerCase())
+        ?? playlists.find((p) => p.name.toLowerCase().startsWith(target.toLowerCase())));
+
+    if (!summary) {
+      this.reply(bot, userClid, `Playlist "${target}" not found. Use !playlist to list.`);
+      return;
+    }
+
+    if (sub === 'add') {
+      // Add the currently playing track to the playlist. YouTube/URL tracks
+      // are already downloaded to MUSIC_DIR — they just lack a Song row.
+      const np = bot.nowPlaying;
+      if (!np) {
+        this.reply(bot, userClid, 'Nothing is playing right now.');
+        return;
+      }
+      const serverConfigId = bot.currentConfig.serverConfigId;
+      if (!serverConfigId) {
+        this.reply(bot, userClid, 'Error: bot has no server config.');
+        return;
+      }
+      let song = await this.prisma.song.findFirst({
+        where: { filePath: np.filePath, serverConfigId },
+      });
+      if (!song) {
+        song = await this.prisma.song.create({
+          data: {
+            title: np.title || 'Unknown Title',
+            artist: np.artist ?? null,
+            duration: np.duration ?? null,
+            filePath: np.filePath,
+            source: (np.source as string) ?? 'local',
+            sourceUrl: np.sourceUrl ?? null,
+            serverConfigId,
+          },
+        });
+      }
+      const last = await this.prisma.playlistSong.findFirst({
+        where: { playlistId: summary.id },
+        orderBy: { position: 'desc' },
+        select: { position: true },
+      });
+      const position = (last?.position ?? -1) + 1;
+      try {
+        await this.prisma.playlistSong.create({
+          data: { playlistId: summary.id, songId: song.id, position },
+        });
+        this.reply(bot, userClid, `Added "${song.title}" to "${summary.name}" (position ${position + 1}).`);
+      } catch {
+        this.reply(bot, userClid, `"${song.title}" is already in "${summary.name}".`);
+      }
+      return;
+    }
+
+    const playlist = await this.prisma.playlist.findUnique({
+      where: { id: summary.id },
+      include: { songs: { include: { song: true }, orderBy: { position: 'asc' } } },
+    });
+
+    if (!playlist || playlist.songs.length === 0) {
+      this.reply(bot, userClid, `Playlist "${summary.name}" is empty.`);
+      return;
+    }
+
+    // Same mapping as the /queue/playlist API route
+    const items = playlist.songs.map((ps: any) => ({
+      id: String(ps.song.id),
+      title: ps.song.title,
+      artist: ps.song.artist ?? undefined,
+      duration: ps.song.duration ?? undefined,
+      filePath: ps.song.filePath,
+      source: ps.song.source as any,
+      sourceUrl: ps.song.sourceUrl ?? undefined,
+    }));
+
+    if (sub === 'play') {
+      bot.queue.clear();
+      bot.queue.addMany(items);
+      const first = bot.queue.playAt(0);
+      if (first) {
+        if (first.streamUrl) {
+          await bot.playStream(first);
+        } else {
+          await bot.play(first);
+        }
+      }
+      this.reply(bot, userClid, `Playing playlist "${playlist.name}" (${items.length} tracks).`);
+    } else {
+      bot.queue.addMany(items);
+      if (bot.status !== 'playing' && bot.status !== 'paused') {
+        const first = bot.queue.playAt(0);
+        if (first) {
+          if (first.streamUrl) {
+            await bot.playStream(first);
+          } else {
+            await bot.play(first);
+          }
+        }
+      }
+      this.reply(bot, userClid, `Queued ${items.length} tracks from "${playlist.name}" (queue: ${bot.queue.length}).`);
+    }
+  }
 }
