+      this.reply(bot, userClid, `Usage: !skipto <queue position> (queue has ${bot.queue.length})`);
+      return;
+    }
+    const item = bot.queue.playAt(n - 1);
+    if (!item) {
+      this.reply(bot, userClid, `Invalid position. Queue has ${bot.queue.length} tracks.`);
+      return;
+    }
+    if (item.streamUrl) {
+      await bot.playStream(item);
+    } else {
+      await bot.play(item);
+    }
+    this.reply(bot, userClid, `Skipped to #${n}: ${item.title}`);
+  }
