index 0000000..c0efae0
--- /dev/null
+++ b/packages/backend/src/voice/auto-dj.ts
@@ -0,0 +1,127 @@
+/**
+ * Pure AutoDJ selection logic — no I/O, no bot state, fully unit-testable.
+ *
+ * The MusicCommandHandler feeds this module runtime snapshots (queue index,
+ * library songs, play counts) and gets back decisions (should we pick a
+ * track, and which one). All randomness is injected so tests are exact.
+ */
+import type { QueueItem } from './playlist/queue.js';
+
+/** Minimal shape of a prisma `Song` row that AutoDJ cares about. */
+export interface AutoDjTrack {
+  id: number | string;
+  title: string;
+  artist?: string | null;
+  duration?: number | null;
+  filePath: string;
+  source: string;
+  sourceUrl?: string | null;
+}
+
+/** Snapshot of the bits of bot + queue state AutoDJ decisions depend on. */
+export interface AutoDjBotState {
+  enabled: boolean;
+  nowPlaying: boolean;
+  status: string;
+  queueIndex: number;
+  queueLength: number;
+  repeat: string;
+}
+
+/** Rolling window of recently AutoDJ'd track keys (deduped against). */
+export const RECENT_WINDOW = 5;
+
+/**
+ * Unplayed tracks left in the queue.
+ *
+ * PlayQueue keeps played items in its array — only `index` advances (and
+ * rewinds to -1 once the queue is exhausted). So `length > 0` does NOT mean
+ * there is anything left to play:
+ *   - length 0            → empty queue, 0 remaining
+ *   - index -1, length >0 → exhausted (every entry played), 0 remaining
+ *   - index i,  length n  → n - i - 1 entries after the current one
+ *
+ * Note: at `trackEnd` emit time `queue.next()` has not run yet, so `index`
+ * still points at the track that just finished — exactly what we want.
+ */
+export function remainingTracks(queueIndex: number, queueLength: number): number {
+  if (queueLength <= 0) return 0;
+  if (queueIndex < 0) return 0;
+  return Math.max(0, queueLength - queueIndex - 1);
+}
+
+/**
+ * Should AutoDJ fire right now? True only when the bot is connected, idle,
+ * repeat is off, and the queue has nothing left to play (possibly because
+ * it is exhausted-but-nonempty — the classic "autodj on but silent" bug).
+ */
+export function shouldAutoDj(state: AutoDjBotState): boolean {
+  if (!state.enabled) return false;
+  if (state.status === 'stopped') return false;
+  if (state.nowPlaying) return false;
+  if (state.repeat !== 'off') return false; // queue never runs dry → nothing to fill
+  return remainingTracks(state.queueIndex, state.queueLength) === 0;
+}
+
+/** Stable identity of a track for dedupe/history weighting. */
+export function trackKey(t: Pick<AutoDjTrack, 'sourceUrl' | 'filePath'>): string {
+  return t.sourceUrl ?? t.filePath;
+}
+
+/** Append a key to the recent window, capped at `size`, without mutating. */
+export function pushRecent(recent: string[], key: string, size: number = RECENT_WINDOW): string[] {
+  return [...recent, key].slice(-size);
+}
+
+export interface PickInput<T extends AutoDjTrack> {
+  songs: readonly T[];
+  /** sourceUrl → request count (favourites come up more often) */
+  playCounts?: ReadonlyMap<string, number>;
+  /** recently played keys; excluded unless that would empty the pool */
+  recent?: readonly string[];
+  /** [0,1) randomness source; defaults to Math.random */
+  rng?: () => number;
+}
+
+/**
+ * Weighted-random pick of the next AutoDJ track.
+ *
+ * - prefers tracks not in `recent`; falls back to the full library if every
+ *   track was played recently
+ * - weight = 1 + historical request count, so favourites surface more often
+ * - never returns null unless `songs` is empty
+ */
+export function pickAutoDjTrack<T extends AutoDjTrack>(input: PickInput<T>): T | null {
+  const { songs, playCounts, recent = [], rng = Math.random } = input;
+  if (songs.length === 0) return null;
+
+  const recentSet = new Set(recent);
+  const fresh = songs.filter((s) => !recentSet.has(trackKey(s)));
+  const candidates = fresh.length > 0 ? fresh : songs;
+
+  const weightOf = (s: T) => 1 + (playCounts?.get(trackKey(s)) ?? 0);
+  const total = candidates.reduce((acc, s) => acc + weightOf(s), 0);
+  let roll = rng() * total;
+  let picked = candidates[candidates.length - 1];
+  for (const s of candidates) {
+    roll -= weightOf(s);
+    if (roll <= 0) {
+      picked = s;
+      break;
+    }
+  }
+  return picked;
+}
+
+/** Map a library row to a queue entry (pure: `now` injected for the id). */
+export function toQueueItem(song: AutoDjTrack, now: number): QueueItem {
+  return {
+    id: `lib_${song.id}_${now}`,
+    title: song.title,
+    artist: song.artist ?? undefined,
+    duration: song.duration ?? undefined,
+    filePath: song.filePath,
+    source: song.source as QueueItem['source'],
+    sourceUrl: song.sourceUrl ?? undefined,
+  };
+}
