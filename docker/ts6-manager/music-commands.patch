--- a/packages/backend/src/voice/audio/pipeline.ts
+++ b/packages/backend/src/voice/audio/pipeline.ts
@@ -158,4 +158,32 @@ export class AudioPipeline {
       });
     });
   }
+
+  private duckDecoder: OpusScript | null = null;
+
+  /** Blend two PCM frames: a fades out, b fades in (t = 0..1 weight of b). */
+  static mixPcm(a: Buffer, b: Buffer, t: number): Buffer {
+    const len = Math.max(a.length, b.length);
+    const out = Buffer.alloc(len);
+    for (let i = 0; i + 1 < len; i += 2) {
+      const sa = i < a.length ? a.readInt16LE(i) : 0;
+      const sb = i < b.length ? b.readInt16LE(i) : 0;
+      const v = Math.round(sa * (1 - t) + sb * t);
+      out.writeInt16LE(Math.max(-32768, Math.min(32767, v)), i);
+    }
+    return out;
+  }
+
+  /** Decode an incoming Opus voice packet for energy analysis (talk-ducking). */
+  decodeVoicePacket(opusData: Buffer): Buffer | null {
+    try {
+      if (!this.duckDecoder) {
+        this.duckDecoder = new OpusScript(SAMPLE_RATE, CHANNELS, OpusScript.Application.AUDIO);
+      }
+      const pcm = this.duckDecoder.decode(opusData);
+      return Buffer.isBuffer(pcm) ? pcm : Buffer.from(pcm);
+    } catch {
+      return null;
+    }
+  }
 }
diff --git a/packages/backend/src/voice/auto-dj.test.ts b/packages/backend/src/voice/auto-dj.test.ts
new file mode 100644
index 0000000..a4ff97c
--- /dev/null
+++ b/packages/backend/src/voice/auto-dj.test.ts
@@ -0,0 +1,317 @@
+import { describe, it } from 'node:test';
+import assert from 'node:assert/strict';
+import {
+  RECENT_WINDOW,
+  pickAutoDjTrack,
+  pushRecent,
+  remainingTracks,
+  shouldAutoDj,
+  toQueueItem,
+  trackKey,
+  type AutoDjTrack,
+} from './auto-dj.js';
+
+/** Deterministic LCG in [0,1) — statistical tests never flake. */
+function lcg(seed: number): () => number {
+  let s = seed >>> 0;
+  return () => {
+    s = (Math.imul(s, 1664525) + 1013904223) >>> 0;
+    return s / 4294967296;
+  };
+}
+
+const song = (over: Partial<AutoDjTrack> & { id: number }): AutoDjTrack => ({
+  title: `Song ${over.id}`,
+  filePath: `/music/${over.id}.mp3`,
+  source: 'youtube',
+  ...over,
+});
+
+describe('remainingTracks', () => {
+  it('empty queue → 0', () => {
+    assert.equal(remainingTracks(-1, 0), 0);
+  });
+
+  it('exhausted queue (index rewound to -1, items still present) → 0', () => {
+    // THE regression: PlayQueue never removes played items.
+    assert.equal(remainingTracks(-1, 1), 0);
+    assert.equal(remainingTracks(-1, 5), 0);
+    assert.equal(remainingTracks(-1, 100), 0);
+  });
+
+  it('playing first of n → n-1 remaining', () => {
+    assert.equal(remainingTracks(0, 3), 2);
+    assert.equal(remainingTracks(0, 1), 0);
+  });
+
+  it('playing mid-queue → counts only entries after current', () => {
+    assert.equal(remainingTracks(1, 3), 1);
+    assert.equal(remainingTracks(2, 5), 2);
+  });
+
+  it('playing last track → 0 (nothing queued behind it)', () => {
+    assert.equal(remainingTracks(2, 3), 0);
+    assert.equal(remainingTracks(4, 5), 0);
+  });
+
+  it('index beyond length (defensive) → 0', () => {
+    assert.equal(remainingTracks(3, 3), 0);
+    assert.equal(remainingTracks(7, 3), 0);
+  });
+});
+
+describe('shouldAutoDj', () => {
+  const idle = {
+    enabled: true,
+    nowPlaying: false,
+    status: 'connected',
+    queueIndex: -1,
+    queueLength: 0,
+    repeat: 'off',
+  };
+
+  it('idle + enabled → fire', () => {
+    assert.equal(shouldAutoDj(idle), true);
+  });
+
+  it('disabled → never fire (even when idle)', () => {
+    assert.equal(shouldAutoDj({ ...idle, enabled: false }), false);
+  });
+
+  it('stopped bot → never fire', () => {
+    assert.equal(shouldAutoDj({ ...idle, status: 'stopped' }), false);
+  });
+
+  it('something playing → never fire', () => {
+    assert.equal(shouldAutoDj({ ...idle, nowPlaying: true, queueIndex: 0, queueLength: 1 }), false);
+  });
+
+  it('paused counts as still playing', () => {
+    assert.equal(shouldAutoDj({ ...idle, status: 'paused', nowPlaying: true, queueIndex: 0, queueLength: 1 }), false);
+  });
+
+  it('queue with unplayed tracks → never fire (upstream advances on its own)', () => {
+    assert.equal(shouldAutoDj({ ...idle, queueIndex: 0, queueLength: 2 }), false);
+    assert.equal(shouldAutoDj({ ...idle, queueIndex: 1, queueLength: 3 }), false);
+  });
+
+  it('REGRESSION: exhausted-but-nonempty queue → fire (old length>0 guard silenced AutoDJ forever)', () => {
+    assert.equal(shouldAutoDj({ ...idle, queueIndex: -1, queueLength: 7 }), true);
+  });
+
+  it('repeat on → never fire (queue never runs dry)', () => {
+    assert.equal(shouldAutoDj({ ...idle, repeat: 'track' }), false);
+    assert.equal(shouldAutoDj({ ...idle, repeat: 'queue' }), false);
+  });
+
+  it('at trackEnd: index still points at finished track, unplayed remain → wait', () => {
+    // emit order: trackEnd fires before queue.next() advances the index
+    assert.equal(shouldAutoDj({ ...idle, queueIndex: 2, queueLength: 5 }), false);
+  });
+
+  it('at trackEnd: finished the last track → fire', () => {
+    assert.equal(shouldAutoDj({ ...idle, queueIndex: 4, queueLength: 5 }), true);
+  });
+});
+
+describe('trackKey', () => {
+  it('prefers sourceUrl', () => {
+    assert.equal(trackKey({ sourceUrl: 'https://yt/x', filePath: '/a.mp3' }), 'https://yt/x');
+  });
+
+  it('falls back to filePath for local tracks', () => {
+    assert.equal(trackKey({ sourceUrl: null, filePath: '/a.mp3' }), '/a.mp3');
+    assert.equal(trackKey({ sourceUrl: undefined, filePath: '/a.mp3' }), '/a.mp3');
+  });
+});
+
+describe('pushRecent', () => {
+  it('appends the key', () => {
+    assert.deepEqual(pushRecent(['a'], 'b'), ['a', 'b']);
+  });
+
+  it('caps at RECENT_WINDOW', () => {
+    let recent: string[] = [];
+    for (let i = 0; i < 20; i++) recent = pushRecent(recent, `k${i}`);
+    assert.equal(recent.length, RECENT_WINDOW);
+    assert.deepEqual(recent, ['k15', 'k16', 'k17', 'k18', 'k19']);
+  });
+
+  it('honours a custom size', () => {
+    assert.deepEqual(pushRecent(['a', 'b'], 'c', 2), ['b', 'c']);
+  });
+
+  it('does not mutate the input array', () => {
+    const input = ['a', 'b'];
+    const out = pushRecent(input, 'c');
+    assert.deepEqual(input, ['a', 'b']);
+    assert.notEqual(input, out);
+  });
+
+  it('empty input works', () => {
+    assert.deepEqual(pushRecent([], 'x'), ['x']);
+  });
+});
+
+describe('pickAutoDjTrack', () => {
+  it('empty library → null', () => {
+    assert.equal(pickAutoDjTrack({ songs: [] }), null);
+  });
+
+  it('single song → always that song, any rng', () => {
+    const s = song({ id: 1 });
+    for (const r of [0, 0.3, 0.999999]) {
+      assert.equal(pickAutoDjTrack({ songs: [s], rng: () => r }), s);
+    }
+  });
+
+  it('rng at the very bottom picks the first candidate', () => {
+    const songs = [song({ id: 1 }), song({ id: 2 }), song({ id: 3 })];
+    assert.equal(pickAutoDjTrack({ songs, rng: () => 0 }), songs[0]);
+  });
+
+  it('rng near the top picks the last candidate', () => {
+    const songs = [song({ id: 1 }), song({ id: 2 }), song({ id: 3 })];
+    assert.equal(pickAutoDjTrack({ songs, rng: () => 0.9999999 }), songs[2]);
+  });
+
+  it('exact weighted boundaries: weights 1 vs 3 over total 4', () => {
+    const a = song({ id: 1, sourceUrl: 'a' });
+    const b = song({ id: 2, sourceUrl: 'b' });
+    const counts = new Map([['a', 0], ['b', 2]]); // w(a)=1, w(b)=3
+    // roll = rng*4; a wins while roll <= 1 (rng <= 0.25), b after
+    assert.equal(pickAutoDjTrack({ songs: [a, b], playCounts: counts, rng: () => 0.25 }), a);
+    assert.equal(pickAutoDjTrack({ songs: [a, b], playCounts: counts, rng: () => 0.2500001 }), b);
+    assert.equal(pickAutoDjTrack({ songs: [a, b], playCounts: counts, rng: () => 0.5 }), b);
+    assert.equal(pickAutoDjTrack({ songs: [a, b], playCounts: counts, rng: () => 0.9999999 }), b);
+  });
+
+  it('unweighted track (no history) has weight 1', () => {
+    const a = song({ id: 1, sourceUrl: 'a' });
+    const b = song({ id: 2, sourceUrl: 'b' });
+    const counts = new Map([['b', 8]]); // w(a)=1, w(b)=9, total 10
+    assert.equal(pickAutoDjTrack({ songs: [a, b], playCounts: counts, rng: () => 0.09 }), a);
+    assert.equal(pickAutoDjTrack({ songs: [a, b], playCounts: counts, rng: () => 0.11 }), b);
+  });
+
+  it('local files weight on filePath key, youtube on sourceUrl key', () => {
+    const local = song({ id: 1, source: 'local', sourceUrl: null, filePath: '/l.mp3' });
+    const yt = song({ id: 2, sourceUrl: 'yt', filePath: '/y.mp3' });
+    const counts = new Map([['/l.mp3', 4], ['yt', 0]]); // w(local)=5, w(yt)=1, total 6
+    assert.equal(pickAutoDjTrack({ songs: [local, yt], playCounts: counts, rng: () => 0.5 }), local);
+    assert.equal(pickAutoDjTrack({ songs: [local, yt], playCounts: counts, rng: () => 5 / 6 }), local);
+    assert.equal(pickAutoDjTrack({ songs: [local, yt], playCounts: counts, rng: () => 0.9 }), yt);
+  });
+
+  it('excludes recently played tracks', () => {
+    const songs = [song({ id: 1, sourceUrl: 'a' }), song({ id: 2, sourceUrl: 'b' })];
+    for (const r of [0, 0.5, 0.9999999]) {
+      assert.equal(pickAutoDjTrack({ songs, recent: ['a'], rng: () => r }), songs[1]);
+    }
+  });
+
+  it('all tracks recent → falls back to full library', () => {
+    const songs = [song({ id: 1, sourceUrl: 'a' }), song({ id: 2, sourceUrl: 'b' })];
+    assert.equal(pickAutoDjTrack({ songs, recent: ['a', 'b'], rng: () => 0 }), songs[0]);
+    assert.equal(pickAutoDjTrack({ songs, recent: ['a', 'b'], rng: () => 0.999 }), songs[1]);
+  });
+
+  it('recent filtering beats weighting: the only fresh track always wins', () => {
+    const fresh = song({ id: 1, sourceUrl: 'fresh' });
+    const fav = song({ id: 2, sourceUrl: 'fav' });
+    const counts = new Map([['fav', 1000]]); // heavily weighted
+    for (const r of [0, 0.2, 0.4, 0.6, 0.8, 0.999]) {
+      assert.equal(pickAutoDjTrack({ songs: [fresh, fav], playCounts: counts, recent: ['fav'], rng: () => r }), fresh);
+    }
+  });
+
+  it('returns an element of the input array (identity, not a copy)', () => {
+    const songs = [song({ id: 1 }), song({ id: 2 })];
+    const picked = pickAutoDjTrack({ songs, rng: lcg(7) });
+    assert.ok(songs.includes(picked!));
+  });
+
+  it('rng sweep: every pick is a valid candidate across the whole [0,1) domain', () => {
+    const songs = Array.from({ length: 25 }, (_, i) => song({ id: i, sourceUrl: `u${i}` }));
+    const counts = new Map(songs.map((s, i) => [s.sourceUrl!, i % 4]));
+    const seen = new Set<string>();
+    for (let i = 0; i < 1000; i++) {
+      const picked = pickAutoDjTrack({ songs, playCounts: counts, rng: () => i / 1000 });
+      assert.ok(picked, `rng=${i / 1000} produced null`);
+      assert.ok(songs.includes(picked));
+      seen.add(picked.sourceUrl!);
+    }
+    // full-domain sweep must reach every candidate at least once
+    assert.equal(seen.size, songs.length);
+  });
+
+  it('statistical: 9x-weighted track wins ~90% over 20k seeded draws', () => {
+    const a = song({ id: 1, sourceUrl: 'a' });
+    const b = song({ id: 2, sourceUrl: 'b' });
+    const counts = new Map([['b', 8]]); // w(a)=1, w(b)=9
+    let bWins = 0;
+    const rng = lcg(42);
+    for (let i = 0; i < 20000; i++) {
+      if (pickAutoDjTrack({ songs: [a, b], playCounts: counts, rng }) === b) bWins++;
+    }
+    const share = bWins / 20000;
+    assert.ok(share > 0.86 && share < 0.94, `expected ~0.9, got ${share}`);
+  });
+
+  it('statistical: unweighted library distributes across all tracks over seeded draws', () => {
+    const songs = Array.from({ length: 8 }, (_, i) => song({ id: i, sourceUrl: `u${i}` }));
+    const hits = new Map<string, number>();
+    const rng = lcg(1234);
+    for (let i = 0; i < 16000; i++) {
+      const p = pickAutoDjTrack({ songs, rng })!;
+      hits.set(p.sourceUrl!, (hits.get(p.sourceUrl!) ?? 0) + 1);
+    }
+    assert.equal(hits.size, songs.length);
+    for (const n of hits.values()) {
+      const share = n / 16000;
+      assert.ok(share > 0.08 && share < 0.17, `uniform track share out of band: ${share}`);
+    }
+  });
+
+  it('recent window cycles: with window 5 and library 3, rotation still reaches every track', () => {
+    const songs = [song({ id: 1, sourceUrl: 'a' }), song({ id: 2, sourceUrl: 'b' }), song({ id: 3, sourceUrl: 'c' })];
+    let recent: string[] = [];
+    const rng = lcg(99);
+    const hits = new Map<string, number>();
+    for (let i = 0; i < 3000; i++) {
+      const p = pickAutoDjTrack({ songs, recent, rng })!;
+      hits.set(p.sourceUrl!, (hits.get(p.sourceUrl!) ?? 0) + 1);
+      recent = pushRecent(recent, trackKey(p));
+    }
+    assert.equal(hits.size, songs.length);
+  });
+});
+
+describe('toQueueItem', () => {
+  it('maps all fields and embeds id + timestamp', () => {
+    const s = song({ id: 13, title: '505', artist: 'Arctic Monkeys', duration: 245, sourceUrl: 'yt' });
+    assert.deepEqual(toQueueItem(s, 1700000000000), {
+      id: 'lib_13_1700000000000',
+      title: '505',
+      artist: 'Arctic Monkeys',
+      duration: 245,
+      filePath: '/music/13.mp3',
+      source: 'youtube',
+      sourceUrl: 'yt',
+    });
+  });
+
+  it('null optionals become undefined (JSON-clean), not null', () => {
+    const s = song({ id: 1, artist: null, duration: null, sourceUrl: null });
+    const item = toQueueItem(s, 5);
+    assert.equal(item.artist, undefined);
+    assert.equal(item.duration, undefined);
+    assert.equal(item.sourceUrl, undefined);
+    assert.equal('artist' in item && item.artist === null, false);
+  });
+
+  it('distinct ids for distinct timestamps (dedupes queue entries)', () => {
+    const s = song({ id: 9 });
+    assert.notEqual(toQueueItem(s, 1).id, toQueueItem(s, 2).id);
+  });
+});
