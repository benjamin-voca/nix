+  private async handleHistory(botId: number, bot: VoiceBot, userClid: number, args: string): Promise<void> {
+    const dbBot = await this.prisma.musicBot.findUnique({ where: { id: botId }, select: { serverConfigId: true } });
+    if (!dbBot) {
+      this.reply(bot, userClid, 'Bot config not found.');
+      return;
+    }
+    const entries = await this.prisma.playedTrack.findMany({
+      where: { serverConfigId: dbBot.serverConfigId },
+      orderBy: { playedAt: 'desc' },
+      take: 10,
+    });
+    if (entries.length === 0) {
+      this.reply(bot, userClid, 'No history yet — play something first.');
+      return;
+    }
+
+    if (!args) {
+      const lines = entries.map((e, i) => {
+        const artist = e.artist ? `${e.artist} - ` : '';
+        const when = e.playedAt.toISOString().substring(11, 16);
+        return `[${i + 1}] ${artist}${e.title} (${when} UTC)`;
+      });
+      this.reply(bot, userClid, `Recently played:\n${lines.join('\n')}\n!history play <n> — play again`);
+      return;
+    }
+
+    // !history play <n> — replay an entry
+    if (args.toLowerCase().startsWith('play')) {
+      const n = parseInt(args.split(/\s+/)[1]);
+      if (isNaN(n) || n < 1 || n > entries.length) {
+        this.reply(bot, userClid, `Usage: !history play <1-${entries.length}>`);
+        return;
+      }
+      const e = entries[n - 1];
+      this.reply(bot, userClid, `Replaying: ${e.title}...`);
+      if (e.source === 'radio' && e.sourceUrl) {
+        const item: QueueItem = {
+          id: `hist_radio_${Date.now()}`,
+          title: e.title,
+          artist: e.artist ?? undefined,
+          duration: e.duration ?? undefined,
+          filePath: '',
+          source: 'radio',
+          streamUrl: e.sourceUrl,
+        };
+        bot.queue.add(item);
+        if (bot.status !== 'playing' && bot.status !== 'paused') {
+          await bot.playStream(item);
+          this.reply(bot, userClid, `Now playing: ${e.title}`);
+        }
+        return;
+      }
+      if (e.filePath && fs.existsSync(e.filePath)) {
+        const item: QueueItem = {
+          id: `hist_${e.id}_${Date.now()}`,
+          title: e.title,
+          artist: e.artist ?? undefined,
+          duration: e.duration ?? undefined,
+          filePath: e.filePath,
+          source: (e.source as any),
+          sourceUrl: e.sourceUrl ?? undefined,
+        };
+        bot.queue.add(item);
+        if (bot.status !== 'playing' && bot.status !== 'paused') {
+          bot.queue.playAt(bot.queue.length - 1);
+          await bot.play(item);
+          this.reply(bot, userClid, `Now playing: ${e.title}`);
+        } else {
+          this.reply(bot, userClid, `Queued: ${e.title} (position #${bot.queue.length})`);
+        }
+        return;
+      }
+      if (e.sourceUrl) {
+        await this.downloadAndPlay(bot, userClid, e.sourceUrl);
+        return;
+      }
+      this.reply(bot, userClid, 'Original file is gone and there is no URL to re-fetch.');
+      return;
+    }
+
+    this.reply(bot, userClid, 'Usage: !history [play <n>]');
+  }
