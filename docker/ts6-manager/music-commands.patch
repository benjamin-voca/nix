+
+  private handleDuck(bot: VoiceBot, userClid: number, args: string): void {
+    if (!args || args === 'status') {
+      this.reply(bot, userClid, `Talk-ducking: ${bot.ducking ? 'on — volume drops to 25% while others speak' : 'off'}. Usage: !duck on|off`);
