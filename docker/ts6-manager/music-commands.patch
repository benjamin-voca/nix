+  private handleSeek(bot: VoiceBot, userClid: number, args: string): void {
+    const prog = bot.playbackProgress;
+    if (!prog) {
+      this.reply(bot, userClid, 'Nothing playing (live streams cannot seek).');
+      return;
+    }
+    const fmt = (s: number) => `${Math.floor(s / 60)}:${String(Math.floor(s % 60)).padStart(2, '0')}`;
+    if (!args) {
+      this.reply(bot, userClid, `Position: ${fmt(prog.position)} / ${fmt(prog.duration)}. Usage: !seek <sec|m:ss|+s|-s>`);
+      return;
+    }
+    let target: number | null = null;
+    if (/^\+\d+/.test(args)) {
+      const d = this.parseDurationSeconds(args.slice(1));
+      target = d === null ? null : prog.position + d;
+    } else if (/^-\d+/.test(args)) {
+      const d = this.parseDurationSeconds(args.slice(1));
+      target = d === null ? null : prog.position - d;
+    } else {
