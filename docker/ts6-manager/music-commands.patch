+  private handleSleep(botId: number, bot: VoiceBot, userClid: number, args: string): void {
+    const existing = this.sleepTimers.get(botId);
+    if (!args) {
+      if (existing) {
+        const left = Math.max(0, Math.ceil((existing.endsAt - Date.now()) / 60000));
+        this.reply(bot, userClid, `Sleep timer: stopping in ${left} min.`);
+      } else {
+        this.reply(bot, userClid, 'Usage: !sleep <minutes> · !sleep off');
+      }
+      return;
+    }
+    if (args.toLowerCase() === 'off' || args === '0') {
+      if (existing) {
+        clearTimeout(existing.timer);
+        this.sleepTimers.delete(botId);
+      }
+      this.reply(bot, userClid, 'Sleep timer cancelled.');
+      return;
+    }
+    const mins = parseFloat(args);
+    if (isNaN(mins) || mins <= 0 || mins > 720) {
+      this.reply(bot, userClid, 'Usage: !sleep <1-720 minutes|off>');
+      return;
+    }
+    if (existing) clearTimeout(existing.timer);
+    const endsAt = Date.now() + mins * 60_000;
+    const timer = setTimeout(() => {
+      this.sleepTimers.delete(botId);
+      try {
+        bot.stopAudio();
+        bot.queue.clear();
+      } catch { }
+      this.reply(bot, userClid, 'Sleep timer finished — playback stopped.');
+    }, mins * 60_000);
+    this.sleepTimers.set(botId, { timer, endsAt, invokerClid: userClid });
+    this.reply(bot, userClid, `Sleep timer set: stopping in ${mins} min.`);
+  }
