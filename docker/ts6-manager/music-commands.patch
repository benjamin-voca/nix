+
+    if (playlists.length === 0) {
+      this.reply(bot, userClid, 'No playlists. Create one in the web UI (Music Bots → Playlists).');
+      return;
+    }
+
+    const parts = args.trim().split(/\s+/);
+    const sub = (parts[0] || '').toLowerCase();
+    const target = parts.slice(1).join(' ').trim();
+
+    if (!sub || sub === 'list') {
+      const lines = playlists.map((p) => `[${p.id}] ${p.name} (${p._count.songs} tracks)`);
+      this.reply(bot, userClid, `Playlists:\n${lines.join('\n')}\n!playlist play <id|name> — replace queue & play\n!playlist queue <id|name> — append to queue\n!playlist add <id|name> — add current track`);
+      return;
+    }
+
+    if (sub !== 'play' && sub !== 'queue' && sub !== 'add') {
+      this.reply(bot, userClid, 'Usage: !playlist [list|play <id|name>|queue <id|name>|add <id|name>]');
+      return;
+    }
+
+    if (!target) {
+      this.reply(bot, userClid, `Usage: !playlist ${sub} <id|name>`);
+      return;
+    }
+
+    const asId = parseInt(target);
+    const summary = !isNaN(asId)
+      ? playlists.find((p) => p.id === asId)
+      : (playlists.find((p) => p.name.toLowerCase() === target.toLowerCase())
+        ?? playlists.find((p) => p.name.toLowerCase().startsWith(target.toLowerCase())));
+
+    if (!summary) {
+      this.reply(bot, userClid, `Playlist "${target}" not found. Use !playlist to list.`);
+      return;
+    }
+
+    if (sub === 'add') {
+      // Add the currently playing track to the playlist. YouTube/URL tracks
+      // are already downloaded to MUSIC_DIR — they just lack a Song row.
+      const np = bot.nowPlaying;
