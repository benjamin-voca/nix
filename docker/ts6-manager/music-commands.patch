+  /** !lib — browse and play the music library from chat. */
+  private async handleLib(bot: VoiceBot, userClid: number, args: string): Promise<void> {
+    const serverConfigId = bot.currentConfig.serverConfigId;
+    if (!serverConfigId) {
+      this.reply(bot, userClid, 'Error: bot has no server config.');
+      return;
+    }
+    const parts = (args || '').trim().split(/\s+/);
+    const sub = (parts[0] || '').toLowerCase();
+    const rest = args ? args.substring(sub.length).trim() : '';
+
+    if (!sub || sub === 'list') {
+      const songs = await this.prisma.song.findMany({ where: { serverConfigId }, orderBy: { id: 'asc' }, take: 10 });
+      const total = await this.prisma.song.count({ where: { serverConfigId } });
+      if (songs.length === 0) {
+        this.reply(bot, userClid, 'Library is empty. Upload songs in the web UI (Library tab).');
+        return;
+      }
+      const lines = songs.map((sg) => `[${sg.id}] ${sg.artist ? sg.artist + ' - ' : ''}${sg.title}`);
+      this.reply(bot, userClid, `Library (${total} tracks):\n${lines.join('\n')}\n!lib play <id|name> — queue a track`);
+      return;
+    }
+
+    if (sub === 'play') {
+      if (!rest) {
+        this.reply(bot, userClid, 'Usage: !lib play <id|name>');
+        return;
+      }
+      const asId = parseInt(rest);
+      const song = !isNaN(asId)
+        ? await this.prisma.song.findFirst({ where: { id: asId, serverConfigId } })
+        : await this.prisma.song.findFirst({
+            where: { serverConfigId, title: { contains: rest } },
+            orderBy: { id: 'asc' },
+          });
+      if (!song) {
+        this.reply(bot, userClid, `Library track "${rest}" not found. Use !lib to list.`);
+        return;
+      }
+      const item: QueueItem = {
+        id: `lib_${song.id}_${Date.now()}`,
+        title: song.title,
+        artist: song.artist ?? undefined,
+        duration: song.duration ?? undefined,
+        filePath: song.filePath,
+        source: song.source as any,
+        sourceUrl: song.sourceUrl ?? undefined,
+      };
+      bot.queue.add(item);
+      if (bot.status === 'playing' || bot.status === 'paused') {
+        this.reply(bot, userClid, `Queued: ${item.title} (position #${bot.queue.length})`);
+      } else {
+        bot.queue.playAt(bot.queue.length - 1);
+        await bot.play(item);
+        this.reply(bot, userClid, `Now playing: ${item.title}`);
+      }
+      return;
