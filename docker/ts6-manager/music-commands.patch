+  private parseDurationSeconds(text: string): number | null {
+    const t = text.trim().toLowerCase();
+    if (/^\d+$/.test(t)) return parseInt(t);
+    const m = t.match(/^(\d+):([0-5]?\d)$/);
+    if (m) return parseInt(m[1]) * 60 + parseInt(m[2]);
+    return null;
+  }
