+  /** Fire-and-forget persistence of a bot runtime setting (QuadNix custom). */
+  private persistBotSetting(botId: number, data: Record<string, unknown>): void {
+    this.prisma.musicBot.update({ where: { id: botId }, data }).catch((err: any) => {
+      console.error(`[MusicCmd] persist setting failed: ${err.message}`);
