+  private async handleAvatar(bot: VoiceBot, userClid: number, args: string): Promise<void> {
+    console.log(`[Avatar] cmd: "${args}" (ts3id=${bot.ts3ClientId})`);
+    if (!args) {
+      this.reply(bot, userClid, 'Usage: !avatar <image-url> · !avatar file <path> · !avatar off — remove (max 250 KB)');
+      return;
+    }
+    try {
+      // Resolve the bot's client database id via the WebQuery clientlist
+      // (voice-protocol whoami returns dbid=0 on the TS6 beta server)
+      const cfg = await this.prisma.tsServerConfig.findUnique({ where: { id: bot.currentConfig.serverConfigId } });
+      if (!cfg) throw new Error('server config not found');
+      // NOTE: node fetch blocks port 10080 (Chromium blocklist) — use http.get
+      const listResp: any = await new Promise((resolve, reject) => {
+        http
+          .get(
+            `http://${cfg.host}:${cfg.webqueryPort}/1/clientlist`,
+            { headers: { 'x-api-key': decrypt(cfg.apiKey) } },
+            (res) => {
+              let d = '';
+              res.on('data', (c: Buffer) => (d += c));
+              res.on('end', () => {
+                try {
+                  resolve(JSON.parse(d));
+                } catch (e: any) {
+                  reject(e);
+                }
+              });
+            },
+          )
+          .on('error', reject);
+      });
+      const list: any = listResp;
+      const botEntry = (list.body ?? []).find((c: any) => parseInt(c.clid) === bot.ts3ClientId);
+      if (!botEntry) throw new Error(`bot not found in clientlist (ts3id=${bot.ts3ClientId})`);
+      const dbid = parseInt(botEntry.client_database_id);
+      console.log(`[Avatar] dbid=${dbid} (clid=${botEntry.clid})`);
+      if (args === 'off' || args === 'remove') {
+        const ft = await this.ftInitUploadViaSsh(bot, 0, `/avatar_${dbid}`);
+        await bot.uploadFtData(ft.ftkey, ft.port, Buffer.alloc(0));
+        this.reply(bot, userClid, 'Avatar removed.');
+        return;
+      }
+      let buf: Buffer;
+      if (args.startsWith('file ')) {
+        // Admin path: kubectl cp an image into the pod, then set it
+        const p = args.slice(5).trim();
+        buf = fs.readFileSync(p);
+      } else {
+        if (!/^https?:\/\//.test(args)) {
+          this.reply(bot, userClid, 'Usage: !avatar <image-url> | !avatar file <path> | !avatar off');
+          return;
+        }
+        this.reply(bot, userClid, 'Downloading image...');
+        const resp = await fetch(args);
+        if (!resp.ok) throw new Error(`HTTP ${resp.status}`);
+        buf = Buffer.from(await resp.arrayBuffer());
+      }
+      if (buf.length === 0) throw new Error('empty file');
+      if (buf.length > 250_000) throw new Error(`image too large (${Math.round(buf.length / 1024)} KB, max 250 KB)`);
+      const isPng = buf[0] === 0x89 && buf[1] === 0x50;
+      const isJpg = buf[0] === 0xff && buf[1] === 0xd8;
+      const isGif = buf[0] === 0x47 && buf[1] === 0x49;
+      if (!isPng && !isJpg && !isGif) throw new Error('not an image (png/jpg/gif only)');
+      const ft = await this.ftInitUploadViaSsh(bot, buf.length, `/avatar_${dbid}`);
+      await bot.uploadFtData(ft.ftkey, ft.port, buf);
+      this.reply(bot, userClid, `Avatar set (${Math.round(buf.length / 1024)} KB).`);
+    } catch (err: any) {
+      console.error(`[Avatar] FAILED: ${err.message}`);
+      this.reply(bot, userClid, `Avatar failed: ${err.message}`);
+    }
+  }
+
+  /**
+   * One-shot SSH query: run ftinitupload as serveradmin (full rights — the
+   * TS6 voice-protocol ftinitupload returns no ftkey and the WebQuery API
+   * blocks filetransfer commands for API keys). Returns ftkey + port.
+   */
+  private async ftInitUploadViaSsh(bot: VoiceBot, size: number, avatarName: string): Promise<{ ftkey: string; port: number }> {
+    const cfg = await this.prisma.tsServerConfig.findUnique({ where: { id: bot.currentConfig.serverConfigId } });
+    if (!cfg?.sshUsername || !cfg.sshPassword || !cfg.sshPort) {
+      throw new Error('SSH query credentials not configured for this server');
+    }
+    const client = new SshQueryClient({
+      host: cfg.host,
+      port: cfg.sshPort,
+      username: cfg.sshUsername,
+      password: decrypt(cfg.sshPassword),
+    });
+    await client.connect();
+    try {
+      // SSH query sessions start at instance level — file commands are
+      // virtual-server scoped (error 1024 invalid serverID without this)
+      await client.executeCommand('use sid=1');
+      const response = await client.executeCommand(
+        `ftinitupload clientftfid=1 name=${avatarName} cid=0 cpw= size=${size} overwrite=1 resume=0`,
+      );
+      console.log(`[Avatar] ssh ftinitupload: ${response.substring(0, 160)}`);
+      const ftkeyMatch = response.match(/ftkey=([^\s]+)/);
+      const portMatch = response.match(/port=(\d+)/);
+      if (!ftkeyMatch) throw new Error(`ftinitupload response: ${response.substring(0, 120)}`);
+      return { ftkey: ftkeyMatch[1], port: portMatch ? parseInt(portMatch[1]) : 30033 };
+    } finally {
+      try { client.destroy(); } catch { }
+    }
+  }
+
+  /** AutoDJ: queue empty + idle → play a weighted-random library track. */
+  private async maybeAutoDj(botId: number, bot: VoiceBot): Promise<void> {
+    if (!this.autoDjEnabled.get(botId)) return;
+    if (bot.queue.length > 0 || bot.nowPlaying || bot.status === 'stopped') return;
+    const dbBot = await this.prisma.musicBot.findUnique({ where: { id: botId }, select: { serverConfigId: true } });
+    if (!dbBot) return;
+    const songs = await this.prisma.song.findMany({ where: { serverConfigId: dbBot.serverConfigId } });
+    if (songs.length === 0) return;
+
+    // Weight by play history — favourites come up more often
+    const history = await this.prisma.musicRequest.findMany({
+      where: { serverConfigId: dbBot.serverConfigId },
+      select: { url: true },
+    });
+    const weights = new Map<string, number>();
+    for (const h of history) weights.set(h.url, (weights.get(h.url) ?? 0) + 1);
+
+    const recent = new Set(this.recentAutoDj.get(botId) ?? []);
+    const fresh = songs.filter((s) => !recent.has(s.sourceUrl ?? s.filePath));
+    const candidates = fresh.length > 0 ? fresh : songs;
+    const weightOf = (s: any) => 1 + (weights.get(s.sourceUrl ?? '') ?? 0);
+    const total = candidates.reduce((acc, s) => acc + weightOf(s), 0);
+    let roll = Math.random() * total;
+    let picked = candidates[candidates.length - 1];
+    for (const s of candidates) {
+      roll -= weightOf(s);
+      if (roll <= 0) { picked = s; break; }
+    }
+    this.recentAutoDj.set(botId, (this.recentAutoDj.get(botId) ?? []).concat(picked.sourceUrl ?? picked.filePath).slice(-5));
+
+    const item: QueueItem = {
+      id: `lib_${picked.id}_${Date.now()}`,
+      title: picked.title,
+      artist: picked.artist ?? undefined,
+      duration: picked.duration ?? undefined,
+      filePath: picked.filePath,
+      source: picked.source as any,
+      sourceUrl: picked.sourceUrl ?? undefined,
+    };
+    bot.queue.add(item);
+    const first = bot.queue.playAt(bot.queue.length - 1);
+    if (first) await bot.play(first);
+    console.log(`[MusicCmd] AutoDJ bot ${botId}: ${picked.title}`);
+  }
+
+  // ─── Playlist Commands ─────────────────────────────────
+
+  private async handlePlaylist(bot: VoiceBot, userClid: number, args: string): Promise<void> {
+    const playlists = await this.prisma.playlist.findMany({
+      include: { _count: { select: { songs: true } } },
+      orderBy: { id: 'asc' },
+    });
+
+    if (playlists.length === 0) {
+      this.reply(bot, userClid, 'No playlists. Create one in the web UI (Music Bots → Playlists).');
+      return;
+    }
+
+    const parts = args.trim().split(/\s+/);
+    const sub = (parts[0] || '').toLowerCase();
+    const target = parts.slice(1).join(' ').trim();
+
+    if (!sub || sub === 'list') {
+      const lines = playlists.map((p) => `[${p.id}] ${p.name} (${p._count.songs} tracks)`);
+      this.reply(bot, userClid, `Playlists:\n${lines.join('\n')}\n!playlist play <id|name> — replace queue & play\n!playlist queue <id|name> — append to queue\n!playlist add <id|name> — add current track`);
+      return;
+    }
+
+    if (sub !== 'play' && sub !== 'queue' && sub !== 'add') {
+      this.reply(bot, userClid, 'Usage: !playlist [list|play <id|name>|queue <id|name>|add <id|name>]');
+      return;
+    }
+
+    if (!target) {
+      this.reply(bot, userClid, `Usage: !playlist ${sub} <id|name>`);
+      return;
+    }
+
+    const asId = parseInt(target);
+    const summary = !isNaN(asId)
+      ? playlists.find((p) => p.id === asId)
+      : (playlists.find((p) => p.name.toLowerCase() === target.toLowerCase())
+        ?? playlists.find((p) => p.name.toLowerCase().startsWith(target.toLowerCase())));
+
+    if (!summary) {
+      this.reply(bot, userClid, `Playlist "${target}" not found. Use !playlist to list.`);
+      return;
+    }
+
+    if (sub === 'add') {
+      // Add the currently playing track to the playlist. YouTube/URL tracks
+      // are already downloaded to MUSIC_DIR — they just lack a Song row.
+      const np = bot.nowPlaying;
+      if (!np) {
+        this.reply(bot, userClid, 'Nothing is playing right now.');
+        return;
+      }
+      const serverConfigId = bot.currentConfig.serverConfigId;
+      if (!serverConfigId) {
+        this.reply(bot, userClid, 'Error: bot has no server config.');
+        return;
+      }
+      let song = await this.prisma.song.findFirst({
+        where: { filePath: np.filePath, serverConfigId },
+      });
+      if (!song) {
+        song = await this.prisma.song.create({
+          data: {
+            title: np.title || 'Unknown Title',
+            artist: np.artist ?? null,
+            duration: np.duration ?? null,
+            filePath: np.filePath,
+            source: (np.source as string) ?? 'local',
+            sourceUrl: np.sourceUrl ?? null,
+            serverConfigId,
+          },
+        });
+      }
+      const last = await this.prisma.playlistSong.findFirst({
+        where: { playlistId: summary.id },
+        orderBy: { position: 'desc' },
+        select: { position: true },
+      });
+      const position = (last?.position ?? -1) + 1;
+      try {
+        await this.prisma.playlistSong.create({
+          data: { playlistId: summary.id, songId: song.id, position },
+        });
+        this.reply(bot, userClid, `Added "${song.title}" to "${summary.name}" (position ${position + 1}).`);
+      } catch {
+        this.reply(bot, userClid, `"${song.title}" is already in "${summary.name}".`);
+      }
+      return;
+    }
+
+    const playlist = await this.prisma.playlist.findUnique({
+      where: { id: summary.id },
+      include: { songs: { include: { song: true }, orderBy: { position: 'asc' } } },
+    });
+
+    if (!playlist || playlist.songs.length === 0) {
+      this.reply(bot, userClid, `Playlist "${summary.name}" is empty.`);
+      return;
+    }
+
+    // Same mapping as the /queue/playlist API route
+    const items = playlist.songs.map((ps: any) => ({
+      id: String(ps.song.id),
+      title: ps.song.title,
+      artist: ps.song.artist ?? undefined,
+      duration: ps.song.duration ?? undefined,
+      filePath: ps.song.filePath,
+      source: ps.song.source as any,
+      sourceUrl: ps.song.sourceUrl ?? undefined,
+    }));
+
+    if (sub === 'play') {
+      bot.queue.clear();
+      bot.queue.addMany(items);
+      const first = bot.queue.playAt(0);
+      if (first) {
+        if (first.streamUrl) {
+          await bot.playStream(first);
+        } else {
+          await bot.play(first);
+        }
+      }
+      this.reply(bot, userClid, `Playing playlist "${playlist.name}" (${items.length} tracks).`);
+    } else {
+      bot.queue.addMany(items);
+      if (bot.status !== 'playing' && bot.status !== 'paused') {
+        const first = bot.queue.playAt(0);
+        if (first) {
+          if (first.streamUrl) {
+            await bot.playStream(first);
+          } else {
+            await bot.play(first);
+          }
+        }
+      }
+      this.reply(bot, userClid, `Queued ${items.length} tracks from "${playlist.name}" (queue: ${bot.queue.length}).`);
+    }
+  }
 }
